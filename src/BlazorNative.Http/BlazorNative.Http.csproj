<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorNative.Http</RootNamespace>

    <!-- AOT settings live on the publishable runtime (BlazorNative.Runtime),
         not on consumed libraries.
         ZAI007: "class implements no interfaces and will only be registered as
         its concrete type" — informational, expected. BridgeHttpHandler is
         intentionally registered as its concrete type via [Transient]. -->
    <NoWarn>$(NoWarn);ZAI007</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- PHASE 11.3 GATE B — this package carries a PublicAPI.Shipped.txt
         baseline and RS0016/RS0017/RS0037 are ERRORS here. The switch itself
         lives in src/Directory.Build.targets, NOT .props: .props is imported
         BEFORE this line, so a condition there would read the flag empty and
         the pin would be off while reading as on (that file's header carries
         the measurement, and the CS1591 pin paid for it twice). -->
    <BnEnforcePublicApi>true</BnEnforcePublicApi>

    <!-- M11 #173 — DONE, via an UPSTREAM fix. The hand-written surface (BridgeHttpHandler,
         ServiceCollectionExtensions and its AddBlazorNativeHttp / AddBlazorNativeHttpClient
         overloads) is fully `///`-documented, and BnEnforceDocCoverage is ON below, so a
         lost doc comment STOPS COMPILING (CS1591-as-error, src/Directory.Build.targets).

         THE BLOCKER WAS REAL and its resolution is worth recording. ZeroAlloc.Inject.Generator
         emits a PUBLIC `BlazorNativeHttpServicesServiceCollectionExtensions.AddBlazorNativeHttpServices`
         with no XML doc, and CS1591 fired on it. It cannot be pragma'd (generated) nor
         annotated, and NOTHING scopes CS1591 per-file for a consumer: the `// auto-generated`
         header does not exempt a source-generator tree; `.editorconfig` `severity`/
         `generated_code`, `[SuppressMessage]`, and `WarningsNotAsErrors` all either do not
         govern this compiler warning or are package-wide (measured). The ONLY lever is an
         inline `#pragma warning disable 1591` in the generated file — which the CONSUMER
         cannot add. ZeroAlloc.Inject is a first-party package, so the fix landed there:
         v1.7.2 emits `#pragma warning disable 1591` under its `// <auto-generated />`
         header (as the Razor generator does), so CS1591 no longer fires on our output.
         Hence the 1.7.2 floor below.

         The generated extension appears in the reference as a valid signature page (class +
         method + params + returns) under Microsoft.Extensions.DependencyInjection — NOT a
         blank stub: it is the ZeroAlloc primitive that the documented `AddBlazorNativeHttp()`
         wraps, and its signature is the whole of its meaning. -->
    <BnEnforceDocCoverage>true</BnEnforceDocCoverage>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Phase 8.1: shared pack metadata lives in src/Directory.Build.props —
         only the per-package voice stays here. -->
    <Description>BlazorNative HTTP bridge: BridgeHttpHandler routes HttpClient traffic through the hosting native shell, so Blazor components use plain HttpClient/IHttpClientFactory on NativeAOT.</Description>
    <PackageTags>blazor;native;http;httpclient;nativeaot;android;mobile</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorNative.Core\BlazorNative.Core.csproj" />
    <!-- Phase 4.1: BN rules ride every src build (zero-warning bar, M4 DoD #3). -->
    <ProjectReference Include="..\BlazorNative.Analyzers\BlazorNative.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- 1.7.2 floor: ZeroAlloc.Inject.Generator emits `#pragma warning disable 1591` in
         its output as of 1.7.2 (ZeroAlloc-Net/ZeroAlloc.Inject#70), which is what lets
         BnEnforceDocCoverage go on here — see the #173 note above. The runtime package is
         kept in lockstep with the generator. -->
    <PackageReference Include="ZeroAlloc.Inject" Version="1.7.2" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.7.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>analyzers;build</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
