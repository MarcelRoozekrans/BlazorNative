<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- PHASE 11.3 GATE B — this package carries a PublicAPI.Shipped.txt
         baseline and RS0016/RS0017/RS0037 are ERRORS here. The switch itself
         lives in src/Directory.Build.targets, NOT .props: .props is imported
         BEFORE this line, so a condition there would read the flag empty and
         the pin would be off while reading as on (that file's header carries
         the measurement, and the CS1591 pin paid for it twice). -->
    <BnEnforcePublicApi>true</BnEnforcePublicApi>

    <!-- M11 #173 — DOC-ENFORCED, and therefore IN the generated API reference
         (scripts/generate-reference.ps1). The gap the earlier note here described —
         IMobileBridge's 27 members, DevHostBridge, and the wire-mirrored enums /
         records carrying rich `//` block comments but no `///` XML — was closed by
         converting them to consumer-facing XML (the enum values lifted from their
         block-comment tables, DevHostBridge's implementations via <inheritdoc/>).
         Zero CS1591 with the switch on, so it can join the reference: a page here is
         a real page, not a blank stub. Generation and enforcement advance together,
         package by package — Runtime and Http remain deferred (Runtime's ~12 NOT-API
         interop types, Http's undocumented generator-emitted extension). -->
    <BnEnforceDocCoverage>true</BnEnforceDocCoverage>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Phase 8.1: shared pack metadata (Version/Authors/license/readme/
         symbols/SourceLink) lives in src/Directory.Build.props — only the
         per-package voice stays here. See the 2026-07-16 phase-8.1 design. -->
    <Description>Core contracts for BlazorNative: shell bridge and interop abstractions, the INavigationManager contract, and the DI-facing primitives shared by the renderer, HTTP bridge, and component library.</Description>
    <PackageTags>blazor;native;nativeaot;android;mobile;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.AsyncEvents" Version="1.1.2" />
    <PackageReference Include="ZeroAlloc.Inject" Version="1.7.2" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.7.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>analyzers;build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorNative.Renderer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 4.1: BN rules ride every src build (zero-warning bar, M4 DoD #3). -->
    <ProjectReference Include="..\BlazorNative.Analyzers\BlazorNative.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
