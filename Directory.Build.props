<Project>

  <!-- NuGetAudit as ci-baseline's nuget-audit job runs it, so a local restore shows the same advisories.
       src/ and tests/ have their own Directory.Build.props, and each imports this file first. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Debugging into the package: Go to Definition and step-into show the original source.
       The PDB is embedded in each DLL, so consumers need no symbol server setting; Source Link,
       built into the .NET SDK, maps it to this commit on GitHub. ContinuousIntegrationBuild
       makes CI builds deterministic and writes /_/ paths instead of the runner's. It applies to
       the shipped projects under src/ only: in a test project it would also turn CallerFilePath
       into /_/..., which breaks tests that find snapshot files through it.
       One shipped assembly lives outside src/: tools/BlazorNative.RouteGen is packed into the
       BlazorNative.Runtime package under tools/, so the condition names it too. -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' and ($(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src$([System.IO.Path]::DirectorySeparatorChar)')) or '$(MSBuildProjectDirectory)' == '$(MSBuildThisFileDirectory)tools$([System.IO.Path]::DirectorySeparatorChar)BlazorNative.RouteGen')">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
