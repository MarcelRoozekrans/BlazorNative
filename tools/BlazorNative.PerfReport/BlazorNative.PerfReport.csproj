<Project Sdk="Microsoft.NET.Sdk">

  <!-- BlazorNative.PerfReport — Phase 19.2 (measurement harness, Task 4).
       Reads the device logs of two sides (HEAD and the v0.15.0 baseline), pairs the BNPERF
       marks into timed samples and writes samples.csv and summary.md. A CI-time host tool:
       never AOT, never packed. Contract: scripts/perf/README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorNative.PerfReport</RootNamespace>
    <AssemblyName>BlazorNative.PerfReport</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>Major</RollForward>
    <PublishAot>false</PublishAot>
    <UseAppHost>false</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorNative.Runtime.Tests" />
  </ItemGroup>

</Project>
